###########################################################
#                                                         #
#                     Catppodccin SBS                     #
#                                                         #
###########################################################

# Disable Status Bar
%wd

# Load smaller font
%Fl(2,Roboto-14.fnt)


###########################################################
#                                                         #
#                  Load icons and images                  #
#                                                         #
###########################################################

# Battery icons
%xl(a,battery_empty.svg,0,0)
%xl(b,battery_charge.svg,0,0)

# Playback icons
%xl(c,play.svg,0,0)
%xl(d,pause.svg,0,0)
%xl(e,fast_forward.svg,0,0)
%xl(f,fast_backward.svg,0,0)

# Album art mask
%xl(g,album_art_mask.svg,0,0)

# Load default album art 
%xl(h,logo.bmp,0,0)

# Volume icons
%xl(i,volume_icons.svg,0,0)

# Shuffle icons
%xl(j,shuffle_on.svg,0,0)
%xl(k,shuffle_off.svg,0,0)

# Load repeat icons
%xl(l,repeat_off.svg,0,0)
%xl(m,repeat_on.svg,0,0)
%xl(n,repeat_one.svg,0,0)
%xl(o,repeat_shuffle.svg,0,0)
%xl(p,repeat_ab.svg,0,0)

# Load album art
%Cl(0,0,140,140,c,c)

###########################################################
#                                                         #
#                    Display Viewports                    #
#                                                         #
###########################################################

# Main screen
%Vd(main)


###########################################################
#                                                         #
#                           MAIN                          #
#                                                         #
###########################################################
################################
#          STATUS BAR          #
################################

# Battery outline background if not charging
%Vl(main,290,1,28,16,-)%VB
%?bc<|%xd(a)>

# Battery charge or level
%Vl(main,290,1,28,16,-)
%?bc<%xd(b)|%bl(0,0,28,16,battery_full.svg)>

# Page title
%Vl(main,2,2,126,20,2)%Vf(--CATPPUCCIN[text])
%s%al%?it<%it|Catppodccin>

# Time
%Vl(main,130,0,60,18,2)%Vf(--CATPPUCCIN[text])
%ac%cH:%cM

# Playback status icon
%Vl(main,272,1,16,16,-)
%?mp<|%xd(c)|%xd(d)|%xd(e)|%xd(f)>


################################
#          Track Info          #
################################

# Track title
%Vl(main,11,38,140,26,1)%Vf(--CATPPUCCIN[accent])
%s%al%?it<%it|Unknown Title>

# Artist
%Vl(main,11,68,140,20,2)%Vf(--CATPPUCCIN[subtext0])
%s%al%?ia<%ia|Unknown Artist>

# Album
%Vl(main,11,90,140,20,2)%Vf(--CATPPUCCIN[subtext0])
%s%al%?id<%id|Unknown Album>

# Shuffle icon
%Vl(main,37,113,24,24,-)
%?ps<%xd(j)|%xd(k)>

# Repeat icon
%Vl(main,11,113,24,24,-)
%?mm<%xd(l)|%xd(m)|%xd(n)|%xd(o)|%xd(p)>

# Track number
%Vl(main,11,140,140,20,2)%Vf(--CATPPUCCIN[subtext0])
%s%al%pp %Sx(of) %pe

# Current/Remaining time or volume icons
%Vl(main,11,187,298,18,2)%Vf(--CATPPUCCIN[text])
%?mv(2.0)<%xd(i)|%al%pc%ar-%pr>

# Song progress bar or volume bar
%Vl(main,11,211,298,18,-)
%?mv(2.0)<%pv(0,0,298,18,volume_bar.svg)|%pb(0,0,298,18,song_bar.svg)>


###############################
#          Album Art          #
###############################

# Album art
%Vl(main,169,29,140,140,-)%VB
%?C<%Cd|%xd(h)>

# Album art mask
%Vl(main,164,24,150,150,-)
%xd(g)


###########################################################
#                                                         #
#                            BD                           #
#          This intentionally stays at the bottom         #
#   Moving it earlier breaks the album art mask/layering  #
#                                                         #
###########################################################

%X(wps_bd.svg)
