###########################################################
#                                                         #
#                     Catppodccin SBS                     #
#                                                         #
###########################################################

# Disable Status Bar
%wd

# Load smaller font
%Fl(2,Roboto-14.fnt)


###########################################################
#                                                         #
#                  Load icons and images                  #
#                                                         #
###########################################################

# Battery icons
%xl(a,battery_empty.svg,0,0)
%xl(b,battery_charge.svg,0,0)

# Playback icons
%xl(c,play.svg,0,0)
%xl(d,pause.svg,0,0)
%xl(e,fast_forward.svg,0,0)
%xl(f,fast_backward.svg,0,0)

# Album art mask
%xl(g,album_art_mask.svg,0,0)

# Load default album art 
%xl(h,logo.bmp,0,0)

# Load album art
%Cl(0,0,140,140,c,c)

###########################################################
#                                                         #
#                    Display Viewports                    #
#                                                         #
###########################################################

# Main screen
%Vd(main)

# Rockbox menu/list area
%Vi(-,16,34,130,190,1)%Vf(--CATPPUCCIN[text])


###########################################################
#                                                         #
#                           MAIN                          #
#                                                         #
###########################################################
################################
#          STATUS BAR          #
################################

# Battery outline background if not charging
%Vl(main,290,1,28,16,-)%VB
%?bc<|%xd(a)>

# Battery charge or level
%Vl(main,290,1,28,16,-)
%?bc<%xd(b)|%bl(0,0,28,16,battery_full.svg)>

# Page title
%Vl(main,2,2,126,20,2)%Vf(--CATPPUCCIN[text])
%s%al%?Lt<%Lt|Catppodccin>

# Time
%Vl(main,130,0,60,18,2)%Vf(--CATPPUCCIN[text])
%ac%cH:%cM

# Playback status icon
%Vl(main,272,1,16,16,-)
%?mp<|%xd(c)|%xd(d)|%xd(e)|%xd(f)>


################################
#          Track Info          #
################################

# Track title
%Vl(main,169,187,140,26,1)%Vf(--CATPPUCCIN[accent])
%s%al%?it<%it|Catppodccin>

# Artist
%Vl(main,169,215,140,20,2)%Vf(--CATPPUCCIN[subtext0])
%s%al%?ia<%ia|--CATPPUCCIN[version]>


###############################
#          Album Art          #
###############################

# Album art
%Vl(main,169,29,140,140,-)%VB
%?C<%Cd|%xd(h)>

# Album art mask
%Vl(main,164,24,150,150,-)
%xd(g)


###########################################################
#                                                         #
#                            BD                           #
#          This intentionally stays at the bottom         #
#   Moving it earlier breaks the album art mask/layering  #
#                                                         #
###########################################################

%X(sbs_bd.svg)
