# Catppodccin SBS

%wd
%Fl(2,Roboto-14.fnt)

# Load battery icons
%xl(a,battery_0.svg,0,0)
%xl(b,battery_1.svg,0,0)
%xl(c,battery_2.svg,0,0)
%xl(d,battery_3.svg,0,0)
%xl(e,battery_4.svg,0,0)
%xl(f,battery_5.svg,0,0)
%xl(g,battery_6.svg,0,0)
%xl(h,battery_7.svg,0,0)
%xl(i,battery_charge.svg,0,0)

# Load playback icons
%xl(j,play.svg,0,0)
%xl(k,pause.svg,0,0)
%xl(l,fast_forward.svg,0,0)
%xl(m,fast_backward.svg,0,0)

# Load album art mask
%xl(n,album_art_mask.svg,0,0)

# Rockbox Menu/list mask
%xl(o,menu_mask.svg,0,0)

# Load default album art 
%xl(p,logo.bmp,0,0)

# Display custom header viewport
%Vd(header_title)
%Vd(header_time)
%Vd(header_status)
%Vd(header_battery)

# Rockbox menu/list area
%Vi(-,11,29,140,200,1)%Vf(--CATPPUCCIN[text])

# Track info viewports
%Vd(track_title)
%Vd(track_artist)

#
# START OF HEADER DEFINITION
#

# Left title
%Vl(header_title,2,2,126,20,2)%Vf(--CATPPUCCIN[text])
%s%al%?Lt<%Lt|Catppodccin>

# Center time
%Vl(header_time,130,0,60,18,2)%Vf(--CATPPUCCIN[text])
%ac%cH:%cM

# Playback status icon
%Vl(header_status,272,1,16,16,-)
%?mp<|%xd(j)|%xd(k)|%xd(l)|%xd(m)>

# Right battery
%Vl(header_battery,290,1,28,16,-)
%?bp<%xd(i)|%?bl<%xd(a)|%xd(a)|%xd(b)|%xd(c)|%xd(d)|%xd(e)|%xd(f)|%xd(g)|%xd(h)>>

#
# END OF HEADER DEFINITION
#

#
# START OF TRACK INFO
#

# Track title
%Vl(track_title,169,187,140,26,1)%Vf(--CATPPUCCIN[accent])
%s%al%?it<%it|Catppodccin>

# Artist
%Vl(track_artist,169,215,140,20,2)%Vf(--CATPPUCCIN[subtext0])
%s%al%?ia<%ia|--CATPPUCCIN[version]>

#
# END OF ALBUM INFO
#


#
# START OF ALBUM ART
#



# Album art setup
%Cl(0,0,140,140,c,c)

# Album art viewport
%V(169,29,140,140,-)%VB
%?C<%Cd|%xd(p)>

# Album art mask
%V(164,24,150,150,-)
%xd(n)

#
# END OF ALBUM ART
#

# ------------------------------------------------------------
# WPS backdrop
#
# This intentionally stays at the bottom.
# Moving it earlier breaks the album art mask/layering.
# Do not move unless retesting the album art stack.
# ------------------------------------------------------------
%X(sbs_bd.svg)
